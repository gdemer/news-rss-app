Δημιουργία Εφαρμογής Ειδήσεων RSS σε React
https://share.gemini.google/u6kFKqz24qoz
Δημιουργήθηκε με 3.6 Flash 4 Οκτωβρίου 2026 στις 08:20 μ.μ.
Δημοσιεύτηκε στις 5 Οκτωβρίου 2026 στις 06:57 μ.μ.
Create a React project that uses RSS and displays news με απλά λόγια βήμα βήμα

Παρακάτω θα βρεις έναν αναλυτικό, βήμα προς βήμα οδηγό για να δημιουργήσεις μια εφαρμογή σε React η οποία διαβάζει ειδήσεις από ένα RSS feed και τις προβάλλει στην οθόνη με απλό και κατανοητό τρόπο.

💡 Σημαντική σημείωση πριν ξεκινήσουμε (CORS):
Τα RSS feeds είναι συνήθως XML αρχεία σε άλλους διακομιστές (servers). Οι περιηγητές (browsers) για λόγους ασφαλείας εμποδίζουν τις απευθείας αιτήσεις σε άλλα domains (πρόβλημα CORS). Για να προσπεράσουμε αυτό το εμπόδιο εύκολα, θα χρησιμοποιήσουμε ένα CORS Proxy / RSS Parser API, όπως το rss2json, το οποίο μετατρέπει το RSS feed σε εύκολα διαχειρίσιμο μορφότυπο JSON.

Βήμα 1: Δημιουργία του React Project
Ανοίξτε το τερματικό σας (Terminal / Command Prompt / PowerShell) και τρέξτε τις παρακάτω εντολές:

Δημιουργήστε το project με το Vite (είναι η πιο γρήγορη και σύγχρονη μέθοδος):

Bash
npm create vite@latest news-rss-app -- --template react
Μπείτε στον φάκελο του έργου:

Bash
cd news-rss-app
Εγκαταστήστε τις εξαρτήσεις (dependencies):

Bash
npm install
Βήμα 2: Γράψτε τον Κώδικα της Εφαρμογής
Ανοίξτε τον φάκελο news-rss-app στον αγαπημένο σας editor (π.χ. VS Code).

Αντικαταστήστε το περιεχόμενο του αρχείου src/App.jsx με τον παρακάτω πλήρη κώδικα:

JavaScript
import { useState, useEffect } from 'react';
import './App.css';

function App() {
  // State για την αποθήκευση των ειδήσεων
  const [articles, setArticles] = useState([]);
  // State για την κατάσταση φόρτωσης (loading)
  const [loading, setLoading] = useState(true);
  // State για τυχόν σφάλματα (error)
  const [error, setError] = useState(null);

  // RSS Feed URL (Παράδειγμα: Ειδήσεις από το BBC World News)
  const rssUrl = 'http://feeds.bbci.co.uk/news/world/rss.xml';
  
  // Χρήση του rss2json API για αποφυγή προβλημάτων CORS
  const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rssUrl)}`;

  useEffect(() => {
    // Συνάρτηση άντλησης δεδομένων
    const fetchNews = async () => {
      try {
        setLoading(true);
        const response = await fetch(apiUrl);
        const data = await response.json();

        if (data.status === 'ok') {
          setArticles(data.items);
        } else {
          setError('Αποτυχία φόρτωσης του RSS feed.');
        }
      } catch (err) {
        setError('Σφάλμα κατά τη σύνδεση στο διαίκτυο.');
      } finally {
        setLoading(false);
      }
    };

    fetchNews();
  }, [apiUrl]);

  return (
    <div className="container">
      <header className="header">
        <h1>🗞️ Εφαρμογή Ειδήσεων RSS</h1>
        <p>Τελευταίες ειδήσεις σε πραγματικό χρόνο</p>
      </header>

      {/* Εμφάνιση μηνύματος φόρτωσης */}
      {loading && <div className="status">Φόρτωση ειδήσεων...</div>}

      {/* Εμφάνιση σφάλματος αν υπάρξει */}
      {error && <div className="status error">{error}</div>}

      {/* Λίστα Ειδήσεων */}
      {!loading && !error && (
        <div className="news-grid">
          {articles.map((item, index) => (
            <article key={index} className="news-card">
              {/* Αν υπάρχει εικόνα, την εμφανίζουμε */}
              {(item.thumbnail || item.enclosure?.link) && (
                <img
                  src={item.thumbnail || item.enclosure?.link}
                  alt={item.title}
                  className="news-image"
                />
              )}
              <div className="news-content">
                <h2>{item.title}</h2>
                <p className="pub-date">
                  📅 {new Date(item.pubDate).toLocaleString('el-GR')}
                </p>
                {/* Αφαίρεση τυχόν HTML tags από την περιγραφή */}
                <p>{item.description.replace(/<[^>]*>?/gm, '')}</p>
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="read-more-btn"
                >
                  Διαβάστε περισσότερα →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  );
}

export default App;
